<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinWhatsApp.App.Controls.EmojiPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- WhatsApp's emoji, by category, with the ones used last first. -->
    <Grid Width="388" Height="380" RowSpacing="4">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Controls/WhatsAppColors.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="2" />
        <GridView
            x:Name="EmojiGrid"
            Grid.Row="1"
            ContainerContentChanging="OnContainerContentChanging"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Grid Width="32" Height="32" />
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Width" Value="42" />
                    <Setter Property="Height" Value="42" />
                </Style>
            </GridView.ItemContainerStyle>
        </GridView>
    </Grid>
</UserControl>
