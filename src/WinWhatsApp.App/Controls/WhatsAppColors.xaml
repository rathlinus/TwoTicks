<?xml version="1.0" encoding="utf-8"?>
<!--
    WhatsApp's colours for controls whose own resources win over the app's:
    the open and the hovered chat in a list, and the chosen filter or tab.
    Merged into the resources of the parts that use them.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#26C2BDB8" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#33C2BDB8" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#33C2BDB8" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#14C2BDB8" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#26C2BDB8" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#D9FDD3" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#C7F5C0" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#C7F5C0" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#15603E" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#15603E" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#15603E" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="HyperlinkForeground" Color="#027EB5" />
            <SolidColorBrush x:Key="HyperlinkForegroundPointerOver" Color="#0369A1" />
            <SolidColorBrush x:Key="HyperlinkForegroundPressed" Color="#0369A1" />
            <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#027EB5" />
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#0369A1" />
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#0369A1" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#103529" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#15452F" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#15452F" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#D9FDD3" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#D9FDD3" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#D9FDD3" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="HyperlinkForeground" Color="#53BDEB" />
            <SolidColorBrush x:Key="HyperlinkForegroundPointerOver" Color="#7FCFF2" />
            <SolidColorBrush x:Key="HyperlinkForegroundPressed" Color="#7FCFF2" />
            <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#53BDEB" />
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#7FCFF2" />
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#7FCFF2" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
