<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinWhatsApp.App.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:WinWhatsApp.App">

    <!--
        Dark in both themes, as the call window. Setup draws the same window
        while it installs, so the positions here are in packaging\WinWhatsApp.iss
        too, in ShowUpdateWindow.
    -->
    <Canvas Background="#0B141A" RequestedTheme="Dark" Width="300" Height="300">
        <Image x:Name="Logo" Canvas.Left="102" Canvas.Top="64" Width="96" Height="96" />
        <TextBlock x:Name="TitleText" Canvas.Top="186" Width="300" TextAlignment="Center"
                   FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="#E9EDEF" />
        <TextBlock x:Name="DetailText" Canvas.Left="24" Canvas.Top="212" Width="252" TextAlignment="Center" TextWrapping="Wrap"
                   FontFamily="Segoe UI" FontSize="13" Foreground="#8696A0" />
        <Grid x:Name="Bar" Canvas.Left="60" Canvas.Top="250" Width="180" Height="4" CornerRadius="2" Background="#233138">
            <Border x:Name="Fill" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="#00A884" />
        </Grid>
        <Button x:Name="CloseButton" Canvas.Left="100" Canvas.Top="256" Width="100" Visibility="Collapsed"
                Content="{app:L Key=updater.close}" Click="OnCloseClick" />
    </Canvas>
</Window>
