<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinWhatsApp.App.Views.SendMediaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:WinWhatsApp.App.Controls"
    xmlns:m="using:WinWhatsApp.App.Models"
    PreviewKeyDown="OnPreviewKeyDown">

    <UserControl.Resources>
        <!-- A file in the row at the bottom: its picture, green when selected, and a cross to take it out. -->
        <DataTemplate x:Key="TileTemplate" x:DataType="m:PendingFile">
            <Grid Width="56" Height="56" Background="Transparent" PointerEntered="OnTilePointerEntered" PointerExited="OnTilePointerExited" Tag="{x:Bind}" Tapped="OnTileTapped"
                  ToolTipService.ToolTip="{x:Bind Name}">
                <Border Background="{ThemeResource QuoteBackgroundBrush}" CornerRadius="6">
                    <Grid>
                        <Image Source="{x:Bind Thumb, Mode=OneWay}" Stretch="UniformToFill" />
                        <c:WaIcon HorizontalAlignment="Center" VerticalAlignment="Center" Kind="{x:Bind Glyph}" Size="24" Foreground="{ThemeResource IconBrush}"
                                  Visibility="{x:Bind GlyphVisibility}" />
                    </Grid>
                </Border>
                <Border BorderBrush="{ThemeResource AccentGreenBrush}" BorderThickness="2" CornerRadius="6" Opacity="{x:Bind SelectionOpacity, Mode=OneWay}" />
                <Button Width="22" Height="22" Margin="0,-6,-6,0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="Remove"
                        Background="{ThemeResource ComposerBrush}" BorderThickness="0" Click="OnRemoveTileClick" CornerRadius="11"
                        Tag="{x:Bind}" ToolTipService.ToolTip="Remove" Visibility="{x:Bind RemoveVisibility, Mode=OneWay}">
                    <c:WaIcon Kind="Close" Size="14" Foreground="{ThemeResource IconBrush}" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{ThemeResource SurfaceEmphasizedBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Close, and the choice to send photos and videos as files. -->
        <Grid Height="56" Padding="12,0,20,0">
            <Button HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="Close" Click="OnCloseClick" Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Close (Esc)">
                <c:WaIcon Kind="Close" Size="24" />
            </Button>
            <CheckBox x:Name="AsDocumentBox" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Send as files"
                      ToolTipService.ToolTip="Send them in their original quality, as files" />
        </Grid>

        <!-- The selected file, as large as it fits. -->
        <Grid Grid.Row="1" Margin="32,8,32,20">
            <Viewbox x:Name="PictureBox" StretchDirection="DownOnly">
                <Image x:Name="Picture" Stretch="None" />
            </Viewbox>
            <MediaPlayerElement x:Name="VideoPlayer" AreTransportControlsEnabled="True" Visibility="Collapsed" />
            <StackPanel x:Name="FileCard" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Visibility="Collapsed">
                <c:WaIcon HorizontalAlignment="Center" Kind="DocumentFilled" Size="96" Foreground="{ThemeResource MetaTextBrush}" />
                <TextBlock x:Name="FileNameText" MaxWidth="420" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FileInfoText" HorizontalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" Text="No preview available" />
            </StackPanel>
        </Grid>

        <!-- The caption of the selected file. -->
        <Grid Grid.Row="2" MaxWidth="640" MinHeight="48" Margin="24,0,24,16" Padding="4,4,6,4" Background="{ThemeResource ComposerBrush}" CornerRadius="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            </Grid.Resources>
            <TextBox
                x:Name="CaptionBox"
                MaxHeight="140"
                VerticalAlignment="Center"
                AcceptsReturn="True"
                BorderThickness="0"
                FontSize="15"
                Paste="OnCaptionPaste"
                PlaceholderText="Add a caption"
                PreviewKeyDown="OnCaptionKeyDown"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextWrapping="Wrap" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" AutomationProperties.Name="Emoji" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Emoji">
                <c:WaIcon Kind="Mood" Size="24" />
                <Button.Flyout>
                    <Flyout x:Name="EmojiFlyout" Placement="TopEdgeAlignedRight">
                        <c:EmojiPicker x:Name="EmojiPickerPanel" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- The files, a tile to add more, and send. -->
        <Grid Grid.Row="3" Padding="24,14,24,14" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="1" HorizontalAlignment="Center" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                <StackPanel Padding="6,8,6,8" Orientation="Horizontal" Spacing="10">
                    <ItemsControl x:Name="Tiles" ItemTemplate="{StaticResource TileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button Width="56" Height="56" Padding="0" AutomationProperties.Name="Add files" Background="Transparent" BorderBrush="{ThemeResource DividerBrush}"
                            BorderThickness="1" Click="OnAddClick" CornerRadius="6" ToolTipService.ToolTip="Add files">
                        <c:WaIcon Kind="Add" Size="26" Foreground="{ThemeResource IconBrush}" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
            <Button x:Name="SendButton" Grid.Column="2" Width="60" Height="60" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                    AutomationProperties.Name="Send" Background="{ThemeResource SendButtonBrush}" Click="OnSendClick" CornerRadius="30" ToolTipService.ToolTip="Send (Enter)">
                <Button.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1B9A59" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1B8755" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#25D366" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1DAA61" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </Button.Resources>
                <Grid>
                    <c:WaIcon Margin="3,0,0,0" Kind="Send" Size="26" Foreground="{ThemeResource SendButtonIconBrush}" />
                    <InfoBadge x:Name="CountBadge" Margin="0,-30,-30,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource ComposerBrush}"
                               Foreground="{ThemeResource TextPrimaryBrush}" Visibility="Collapsed" />
                </Grid>
            </Button>
        </Grid>
    </Grid>
</UserControl>
