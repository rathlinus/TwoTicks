<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinWhatsApp.App.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:WinWhatsApp.App"
    xmlns:c="using:WinWhatsApp.App.Controls"
    xmlns:m="using:WinWhatsApp.App.Models">

    <UserControl.Resources>
        <!-- A member in the group's info. -->
        <DataTemplate x:Key="MemberTemplate" x:DataType="m:MemberItem">
            <Grid Height="64" Padding="16,0,12,0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:Avatar VerticalAlignment="Center" Size="40" Source="{x:Bind Avatar, Mode=OneWay}" />
                <c:EmojiLabel Text="{x:Bind Name}" Grid.Column="1" VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" />
                <Border Grid.Column="2" Padding="7,2" VerticalAlignment="Center" Background="{ThemeResource FilterChipSelectedBrush}" CornerRadius="6"
                        Visibility="{x:Bind AdminVisibility}">
                    <TextBlock FontSize="12" Foreground="{ThemeResource FilterChipSelectedTextBrush}" Text="{app:L Key=profile.groupAdmin}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- A message in the starred, kept, document, link and search lists. -->
        <DataTemplate x:Key="MessageResultTemplate" x:DataType="app:SearchResult">
            <StackPanel Padding="14,8" Spacing="2">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:EmojiLabel Text="{x:Bind ChatName}" FontSize="15" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Grid.Column="1" FontSize="12" Foreground="{ThemeResource MetaTextBrush}" Text="{x:Bind Time}" />
                </Grid>
                <RichTextBlock c:SearchText.Snippet="{x:Bind Text}" c:SearchText.MatchBrush="{ThemeResource AccentGreenBrush}" FontSize="14"
                               Foreground="{ThemeResource TextSecondaryBrush}" IsTextSelectionEnabled="False" MaxLines="3" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <!-- A photo or video in the media list. -->
        <DataTemplate x:Key="MediaTileTemplate" x:DataType="m:MediaTile">
            <Grid Background="{ThemeResource SurfaceEmphasizedBrush}">
                <Image Source="{x:Bind Picture}" Stretch="UniformToFill" />
                <StackPanel Margin="6,0,0,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="4"
                            Visibility="{x:Bind VideoVisibility}">
                    <c:WaIcon VerticalAlignment="Center" Kind="Video" Size="16" Foreground="White" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="White" Text="{x:Bind DurationText}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="SectionStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="24,0" />
            <Setter Property="Padding" Value="0,10" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>

        <!-- A row of the info: an icon, a title and maybe a line under it. -->
        <Style x:Key="InfoRowStyle" TargetType="Button" BasedOn="{StaticResource ChatRowButtonStyle}">
            <Setter Property="Margin" Value="-16,0" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="56" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{ThemeResource FilterChipBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <!-- Contact info or group info, beside the chat, as in WhatsApp Web. -->
    <Grid Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderBar" Height="60" Padding="10,0,16,0" ColumnSpacing="12" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CloseButton" VerticalAlignment="Center" AutomationProperties.Name="{app:L Key=common.close}" Click="OnCloseClick" Style="{StaticResource IconButtonStyle}">
                <c:WaIcon x:Name="CloseIcon" Kind="Close" Size="22" />
            </Button>
            <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" FontSize="16" FontWeight="Medium" Foreground="{ThemeResource TextPrimaryBrush}" />
        </Grid>

        <!-- One list, so a group of hundreds still scrolls smoothly: the profile is its header, the members its rows. -->
        <ListView
            x:Name="MemberList"
            Grid.Row="1"
            ContainerContentChanging="OnMemberContainerContentChanging"
            IsItemClickEnabled="True"
            ItemClick="OnMemberClick"
            ItemContainerStyle="{StaticResource ChatContainerStyle}"
            ItemTemplate="{StaticResource MemberTemplate}"
            SelectionMode="None">
            <ListView.Header>
                <StackPanel>
                    <StackPanel Padding="24,28,24,22">
                        <c:PlainButton x:Name="PictureButton" HorizontalAlignment="Center" AutomationProperties.Name="{app:L Key=profile.viewPhoto}" Click="OnPictureClick" CornerRadius="100">
                            <c:Avatar x:Name="BigAvatar" Size="200" />
                        </c:PlainButton>
                        <RichTextBlock x:Name="NameText" Margin="0,16,0,0" FontSize="22" Foreground="{ThemeResource TextPrimaryBrush}" IsTextSelectionEnabled="True"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="15" Foreground="{ThemeResource TextSecondaryBrush}"
                                   IsTextSelectionEnabled="True" TextAlignment="Center" TextWrapping="Wrap" />

                        <!-- Message and search, as round buttons with their name under them. -->
                        <StackPanel x:Name="ActionBar" Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="20">
                            <StackPanel x:Name="MessageAction" Spacing="6">
                                <Button Click="OnMessageClick" AutomationProperties.Name="{app:L Key=profile.message}" Style="{StaticResource ActionButtonStyle}">
                                    <c:WaIcon Kind="Chat" Size="24" />
                                </Button>
                                <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" Text="{app:L Key=profile.message}" />
                            </StackPanel>
                            <StackPanel x:Name="SearchAction" Spacing="6">
                                <Button Click="OnSearchClick" AutomationProperties.Name="{app:L Key=profile.search}" Style="{StaticResource ActionButtonStyle}">
                                    <c:WaIcon Kind="Search" Size="24" />
                                </Button>
                                <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" Text="{app:L Key=profile.search}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="AboutSection" Padding="0,14,0,18" Spacing="6" Style="{StaticResource SectionStyle}">
                        <TextBlock x:Name="AboutHeading" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <RichTextBlock x:Name="AboutText" c:ParagraphSelection.IsEnabled="True" FontSize="15" Foreground="{ThemeResource TextPrimaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <TextBlock x:Name="CreatedText" Margin="0,4,0,0" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Media, links and docs, with the newest photos and videos under it. -->
                    <StackPanel x:Name="MediaSection" Style="{StaticResource SectionStyle}">
                        <Button Click="OnMediaClick" Style="{StaticResource InfoRowStyle}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <c:WaIcon VerticalAlignment="Center" Kind="Media" Size="24" Foreground="{ThemeResource IconBrush}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" Text="{app:L Key=profile.mediaLinksDocs}" />
                                <TextBlock x:Name="MediaCount" Grid.Column="2" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <c:WaIcon Grid.Column="3" Margin="-12,0,0,0" VerticalAlignment="Center" Kind="ChevronRight" Size="20" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <Grid x:Name="MediaStrip" Margin="0,6,0,8" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="ChatSection" Style="{StaticResource SectionStyle}">
                        <Button Click="OnStarredClick" Style="{StaticResource InfoRowStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <c:WaIcon VerticalAlignment="Center" Kind="Star" Size="24" Foreground="{ThemeResource IconBrush}" />
                                <TextBlock VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" Text="{app:L Key=profile.starredMessages}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="KeptRow" Click="OnKeptClick" Style="{StaticResource InfoRowStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <c:WaIcon VerticalAlignment="Center" Kind="Keep" Size="24" Foreground="{ThemeResource IconBrush}" />
                                <TextBlock VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" Text="{app:L Key=profile.keptMessages}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MuteRow" Click="OnMuteClick" Style="{StaticResource InfoRowStyle}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <c:WaIcon VerticalAlignment="Center" Kind="Notifications" Size="24" Foreground="{ThemeResource IconBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" Text="{app:L Key=profile.muteNotifications}" />
                                    <TextBlock x:Name="MuteUntilText" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                                <!-- Shows the state; the row decides what a click does. -->
                                <ToggleSwitch x:Name="MuteSwitch" Grid.Column="2" MinWidth="0" Margin="0,0,-8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              IsTabStop="False" OffContent="" OnContent="" />
                            </Grid>
                        </Button>
                        <Button x:Name="DisappearingRow" Click="OnDisappearingClick" Style="{StaticResource InfoRowStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <c:WaIcon VerticalAlignment="Center" Kind="Disappearing" Size="24" Foreground="{ThemeResource IconBrush}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" Text="{app:L Key=profile.disappearingMessages}" />
                                    <TextBlock x:Name="DisappearingText" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Grid Padding="0,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:WaIcon VerticalAlignment="Center" Kind="LockOutline" Size="24" Foreground="{ThemeResource IconBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" Text="{app:L Key=profile.encryption}" />
                                <TextBlock FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Text="{app:L Key=profile.encryptionText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Groups in common, for a person. -->
                    <StackPanel x:Name="GroupsSection" Padding="0,14,0,6" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Margin="24,0">
                        <TextBlock x:Name="GroupsCount" Margin="0,0,0,6" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <ItemsControl x:Name="GroupsList" Margin="-16,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:CommonGroupItem">
                                    <Button Click="OnCommonGroupClick" Style="{StaticResource ChatRowButtonStyle}" Margin="0" Padding="16,0" Height="64" Tag="{x:Bind Jid}">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <c:Avatar VerticalAlignment="Center" IsGroup="True" Size="40" Source="{x:Bind Avatar, Mode=OneWay}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <c:EmojiLabel Text="{x:Bind Name}" FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" />
                                                <c:EmojiLabel Text="{x:Bind Members}" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border x:Name="MembersHeading" Margin="24,0" Padding="0,14,0,6" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
                        <TextBlock x:Name="MembersCount" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </ListView.Header>

            <!-- What can't easily be undone, in red, at the end. -->
            <ListView.Footer>
                <StackPanel x:Name="ActionsSection" Margin="24,8,24,24" Padding="0,10" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
                    <Button x:Name="ClearRow" Click="OnClearClick" Style="{StaticResource InfoRowStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <c:WaIcon VerticalAlignment="Center" Kind="ClearChat" Size="24" Foreground="{ThemeResource FailedBrush}" />
                            <TextBlock VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource FailedBrush}" Text="{app:L Key=profile.clearChat}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BlockRow" Click="OnBlockClick" Style="{StaticResource InfoRowStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <c:WaIcon VerticalAlignment="Center" Kind="Block" Size="24" Foreground="{ThemeResource FailedBrush}" />
                            <TextBlock x:Name="BlockText" VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource FailedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExitRow" Click="OnExitClick" Style="{StaticResource InfoRowStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <c:WaIcon VerticalAlignment="Center" Kind="Logout" Size="24" Foreground="{ThemeResource FailedBrush}" />
                            <TextBlock VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource FailedBrush}" Text="{app:L Key=profile.exitGroup}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteRow" Click="OnDeleteClick" Style="{StaticResource InfoRowStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <c:WaIcon VerticalAlignment="Center" Kind="Delete" Size="24" Foreground="{ThemeResource FailedBrush}" />
                            <TextBlock VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource FailedBrush}" Text="{app:L Key=profile.deleteChat}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ListView.Footer>
        </ListView>

        <!-- A list behind a row of the info: media, starred or kept messages, or a search. -->
        <Grid x:Name="SubPage" Grid.Row="1" Background="{ThemeResource SurfaceBrush}" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="MediaTabs" Padding="16,12,16,8" Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="MediaTab" Click="OnTabClick" Content="{app:L Key=profile.tabMedia}" Style="{StaticResource FilterChipStyle}" Tag="media" />
                <ToggleButton x:Name="DocsTab" Click="OnTabClick" Content="{app:L Key=profile.tabDocs}" Style="{StaticResource FilterChipStyle}" Tag="docs" />
                <ToggleButton x:Name="LinksTab" Click="OnTabClick" Content="{app:L Key=profile.tabLinks}" Style="{StaticResource FilterChipStyle}" Tag="links" />
            </StackPanel>
            <TextBox x:Name="SearchBox" Margin="16,12,16,8" AutomationProperties.Name="{app:L Key=profile.searchInChat}" PlaceholderText="{app:L Key=profile.searchPlaceholder}" TextChanged="OnSearchTextChanged" Visibility="Collapsed" />

            <GridView
                x:Name="MediaGrid"
                Grid.Row="1"
                Padding="12,0,12,12"
                ContainerContentChanging="OnPageContainerContentChanging"
                IsItemClickEnabled="True"
                ItemClick="OnMediaTileClick"
                ItemTemplate="{StaticResource MediaTileTemplate}"
                SelectionMode="None"
                SizeChanged="OnMediaGridSizeChanged">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                        <Setter Property="Margin" Value="2" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </GridView.ItemContainerStyle>
            </GridView>
            <ListView
                x:Name="MessageList"
                Grid.Row="1"
                ContainerContentChanging="OnPageContainerContentChanging"
                IsItemClickEnabled="True"
                ItemClick="OnMessageResultClick"
                ItemContainerStyle="{StaticResource ChatContainerStyle}"
                ItemTemplate="{StaticResource MessageResultTemplate}"
                SelectionMode="None" />
            <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="24,32" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="{ThemeResource TextSecondaryBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
