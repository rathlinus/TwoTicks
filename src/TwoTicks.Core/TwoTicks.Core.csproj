<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything the app does that is not drawing: talking to the WhatsApp helper,
    the data it sends, WhatsApp's text formatting and the settings. No UI, so the
    tests run without a window.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TwoTicks.Core.Tests" />
  </ItemGroup>

  <!-- The app's text, one folder per language. See Loc.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="Strings\**\*.json" WithCulture="false" />
  </ItemGroup>

</Project>
